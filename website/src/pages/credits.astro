---
// Built from the first table in IMAGES.md, so the credits stay in step with it.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from '../lib/site';
import imagesMd from '../../IMAGES.md?raw';

const section = imagesMd.split('## Photos on the site')[1]?.split('\n## ')[0] ?? '';
const rows = section
  .split('\n')
  .filter((l) => l.trim().startsWith('|'))
  .slice(2) // header row and --- row
  .map((l) => l.trim().replace(/^\||\|$/g, '').split('|').map((c) => c.trim()));

const credits = rows.map(([file, usedOn, source, owner, licence]) => {
  const url = source.match(/https?:\/\/\S+/)?.[0];
  return {
    image: getImage(file),
    usedOn,
    source: url ? source.replace(url, '').trim() || 'Photo page' : source.replace(/\s*\(original:[^)]*\)/, ''),
    url,
    owner,
    licence: licence.replace(/\s*\(see note \d\)/, ''),
  };
});
---
<BaseLayout title="Photo Credits" description="Credits for the photographs used on the Thorpe Timbers website.">
  <section class="container-site py-12 lg:py-16">
    <h1 class="text-4xl font-semibold text-forest-800">Photo credits</h1>
    <p class="mt-3 max-w-2xl text-stone">The photographs used on this website and where they come from.</p>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {credits.map((c) => (
        <li class="overflow-hidden rounded-lg border border-forest-900/10 bg-white">
          {c.image && (
            <img src={c.image.src.replace(/-\d+\.webp$/, '-400.webp')} width="400" height={Math.round((400 * c.image.height) / c.image.width)} alt={c.image.alt} loading="lazy" class="aspect-[3/2] w-full object-cover" />
          )}
          <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 p-4 text-sm">
            <dt class="font-semibold">Used on</dt><dd>{c.usedOn}</dd>
            <dt class="font-semibold">Source</dt>
            <dd>{c.url ? <a href={c.url} class="text-forest-700 underline" rel="noopener">{c.source}</a> : c.source}</dd>
            <dt class="font-semibold">By</dt><dd>{c.owner}</dd>
            <dt class="font-semibold">Licence</dt><dd>{c.licence}</dd>
          </dl>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
