---
// One product on the Products page. Content comes from src/data/products.json.
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import Text from './Text.astro';
import { site } from '../lib/site';

interface Props {
  product: {
    id: string;
    name: string;
    image: string;
    summary: string;
    applications: string[];
    sizes: string[];
    certificationBadge: string;
  };
}
const { product: p } = Astro.props;
---
<article id={p.id} class="flex scroll-mt-24 flex-col overflow-hidden rounded-lg border border-forest-900/10 bg-white shadow-sm">
  <div class="relative">
    <Photo name={p.image} label={p.name} sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw" class="aspect-[3/2] w-full" />
    {p.certificationBadge && (
      <span class="absolute top-3 left-3 inline-flex items-center gap-1 rounded-full bg-forest-800 px-3 py-1 text-xs font-semibold text-cream shadow">
        <Icon name="BadgeCheck" class="size-4" /> {p.certificationBadge}
      </span>
    )}
    {/*
      To show a certification badge, set "certificationBadge" in products.json
      (e.g. "Certified to SANS 457-3") ONLY once the product is certified.
      Hard-coded alternative for the CCA poles card:
      <span class="absolute top-3 left-3 rounded-full bg-forest-800 px-3 py-1 text-xs font-semibold text-cream">Certified to SANS 457-3</span>
    */}
  </div>
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h2 class="text-2xl font-semibold text-forest-800">{p.name}</h2>
    <p class="mt-2 text-stone"><Text text={p.summary} /></p>

    <h3 class="mt-5 font-sans text-xs font-semibold tracking-[0.12em] text-timber-700 uppercase">Typical applications</h3>
    <ul class="mt-2 flex flex-wrap gap-2">
      {p.applications.map((a) => (
        <li class="rounded-full bg-forest-50 px-3 py-1 text-sm text-forest-800"><Text text={a} /></li>
      ))}
    </ul>

    <h3 class="mt-5 font-sans text-xs font-semibold tracking-[0.12em] text-timber-700 uppercase">Sizes &amp; grades</h3>
    <ul class="mt-2 space-y-1 text-sm">
      {p.sizes.map((s) => (
        <li class="flex gap-2"><Icon name="Ruler" class="mt-0.5 size-4 shrink-0 text-timber-600" /><span><Text text={s} /></span></li>
      ))}
    </ul>

    <div class="mt-auto pt-6">
      <p class="mb-3 text-sm text-stone">{site.orderNote}</p>
      <a href={`/contact/?product=${p.id}#enquiry`} class="btn btn-forest w-full">
        Enquire about this product <Icon name="ArrowRight" class="size-4" />
      </a>
    </div>
  </div>
</article>
